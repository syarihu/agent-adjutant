+import { describe, expect, it } from "vitest";
+import { addItem, listItems } from "./wishlist";
+
+describe("wishlist", () => {
+  it("lists the newest item first", async () => {
+    await addItem("u1", "A");
+    await addItem("u1", "B");
+    expect(await listItems("u1")).toEqual(["B", "A"]);
+  });
+});
