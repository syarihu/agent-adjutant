+++ b/src/wishlist/wishlist.ts
@@ -0,0 +1,19 @@
+import { db } from "../db";
+
+// Keeps the SKUs a customer wants to buy later, newest first.
+export async function listItems(userId: string): Promise<string[]> {
+  const rows = await db.query("SELECT sku FROM wishlist WHERE user_id = $1 ORDER BY added_at DESC", [userId]);
+  return rows.map(r => r.sku);
+}
+
+export async function addItem(userId: string, sku: string): Promise<void> {
+  await db.query(
+    "INSERT INTO wishlist (user_id, sku, added_at) VALUES ($1, $2, now()) ON CONFLICT DO NOTHING",
+    [userId, sku],
+  );
+}
+
+export async function removeItem(userId: string, sku: string): Promise<void> {
+  await db.query("DELETE FROM wishlist WHERE user_id = $1 AND sku = $2", [userId, sku]);
+}
+
