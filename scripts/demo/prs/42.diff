diff --git a/src/wishlist/routes.ts b/src/wishlist/routes.ts
new file mode 100644
index 0000000..4be1f0a
--- /dev/null
+++ b/src/wishlist/routes.ts
@@ -0,0 +1,22 @@
+import { Router } from "express";
+import { addItem, listItems, removeItem } from "./wishlist";
+
+export const wishlist = Router();
+
+wishlist.get("/wishlist", async (req, res) => {
+  const userId = String(req.query.userId);
+  res.json(await listItems(userId));
+});
+
+wishlist.post("/wishlist", async (req, res) => {
+  const userId = String(req.query.userId);
+  await addItem(userId, req.body.sku);
+  res.status(201).end();
+});
+
+wishlist.delete("/wishlist/:sku", async (req, res) => {
+  const userId = String(req.query.userId);
+  await removeItem(userId, req.params.sku);
+  res.status(204).end();
+});
+
diff --git a/src/wishlist/wishlist.ts b/src/wishlist/wishlist.ts
new file mode 100644
