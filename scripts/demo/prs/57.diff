@@ -0,0 +1,14 @@
+import { describe, expect, it, vi } from "vitest";
+import { checkout } from "./checkout";
+import * as stock from "../catalog/stock";
+
+describe("checkout", () => {
+  it("asks for the stock of every item in one request", async () => {
+    const spy = vi.spyOn(stock, "fetchStocks").mockResolvedValue(new Map([["A", 3], ["B", 1]]));
+    await checkout([{ sku: "A", price: 100, quantity: 2 }, { sku: "B", price: 50, quantity: 1 }]);
+    expect(spy).toHaveBeenCalledTimes(1);
+  });
+  it("refuses an item that is out of stock", async () => {
+    vi.spyOn(stock, "fetchStocks").mockResolvedValue(new Map([["A", 0]]));
+    await expect(checkout([{ sku: "A", price: 100, quantity: 1 }])).rejects.toThrow("out of stock");
+  });
+});
