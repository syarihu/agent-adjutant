@@ -1,5 +1,15 @@
 export async function fetchStock(sku: string): Promise<number> {
   const res = await fetch(`/api/stock/${sku}`);
   const body = await res.json();
   return body.available;
 }
+
+// Ask for every SKU in one request: the stock API answers up to 50 at a time.
+export async function fetchStocks(skus: string[]): Promise<Map<string, number>> {
+  const res = await fetch(`/api/stock?skus=${skus.join(",")}`);
+  const body: { sku: string; available: number }[] = await res.json();
+  return new Map(body.map(s => [s.sku, s.available]));
+}
